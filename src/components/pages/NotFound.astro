---
import Base from '../../layouts/Base.astro';
import PageHead from '../PageHead.astro';
import { strings } from '../../i18n';
import { routes } from '../../i18n/routes';
import type { Lang } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const n = t.notFound;
---
<Base lang={lang} page="notFound" title={n.title} description={n.description}>
  <PageHead heading={n.h1} />
  <div class="white section">
    <div class="wrap">
      <div class="prose">
        <p>{n.text}</p>
        <p><a href={routes.home[lang]}>{t.nav.homeAria}</a></p>
        <p><a href={routes.services[lang]}>{t.nav.services}</a></p>
        <p><a href={routes.contact[lang]}>{t.nav.contact}</a></p>
        <p class="meta" lang={lang === 'en' ? 'sv' : 'en'}>{n.swedish}</p>
      </div>
    </div>
  </div>
</Base>
