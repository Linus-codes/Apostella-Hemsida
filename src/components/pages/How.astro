---
import Base from '../../layouts/Base.astro';
import PageHead from '../PageHead.astro';
import ContactBand from '../ContactBand.astro';
import { strings } from '../../i18n';
import type { Lang } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const h = t.how;
---
<Base lang={lang} page="how" title={h.title} description={h.description}>
  <PageHead heading={h.h1} lede={h.lede} />
  <div class="white section">
    <div class="wrap">
      <ol class="steps big">
        {h.steps.map((s) => (<li><h3>{s.name}</h3><p>{s.text}</p></li>))}
      </ol>
    </div>
  </div>
  <div class="paper section">
    <div class="wrap two">
      <h2>{h.ready.heading}</h2>
      <div class="prose"><p>{h.ready.text}</p></div>
    </div>
    <div class="wrap two later">
      <h2>{h.volume.heading}</h2>
      <div class="prose"><p>{h.volume.text}</p></div>
    </div>
  </div>
  <ContactBand lang={lang} />
</Base>

<style>
  .steps.big li { padding-bottom: 44px; }
  .steps.big h3 { font-size: 1.5rem; }
  @media (min-width: 720px) { .steps.big h3 { font-size: 1.75rem; letter-spacing: -0.02em; } }
  .later { margin-top: 56px; }
</style>
