---
// Apostillecertifikatet, ritat efter byråns egen apostille: rutnät med tio numrerade fält, tvåspråkiga
// underetiketter, blå stämpel, underskrift och guldsigill. Gräddfärgat papper. Underskriften ritas och
// stämpeln landar en gång vid sidladdning. Ingen rörelse vid prefers-reduced-motion.
interface Props { alt: string; animate?: boolean }
const { alt, animate = false } = Astro.props;
---
<figure class:list={['certificate', { animate }]}>
  <svg viewBox="0 0 520 820" role="img" aria-labelledby="cert-title">
    <title id="cert-title">{alt}</title>
    <defs>
      <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#e9d38a" />
        <stop offset="0.5" stop-color="#c9a748" />
        <stop offset="1" stop-color="#a8862c" />
      </linearGradient>
      <path id="stamp-arc" d="M195 590 m-30 0 a30 30 0 1 1 60 0 a30 30 0 1 1 -60 0" />
      <path id="gold-arc" d="M410 742 m-31 0 a31 31 0 1 0 62 0 a31 31 0 1 0 -62 0" />
    </defs>

    <rect class="sheet-2" x="36" y="36" width="470" height="770" rx="3" />
    <rect class="sheet" x="14" y="14" width="470" height="770" rx="3" />

    <!-- rutnät -->
    <g class="grid">
      <rect x="60" y="60" width="400" height="580" />
      <line x1="60" y1="118" x2="460" y2="118" />
      <line x1="60" y1="158" x2="460" y2="158" />
      <line x1="60" y1="194" x2="460" y2="194" />
      <line x1="60" y1="242" x2="460" y2="242" />
      <line x1="60" y1="290" x2="460" y2="290" />
      <line x1="60" y1="342" x2="460" y2="342" />
      <line x1="60" y1="378" x2="460" y2="378" />
      <line x1="60" y1="428" x2="460" y2="428" />
      <line x1="260" y1="378" x2="260" y2="428" />
      <line x1="60" y1="468" x2="460" y2="468" />
      <line x1="60" y1="518" x2="460" y2="518" />
      <line x1="260" y1="518" x2="260" y2="640" />
    </g>

    <!-- rubrik -->
    <text class="h" x="260" y="86" text-anchor="middle">APOSTILLE</text>
    <text class="sub" x="260" y="106" text-anchor="middle">(Convention de La Haye du 5 octobre 1961)</text>

    <!-- fält -->
    <text class="lbl" x="72" y="138">1. Country:</text>
    <text class="sm" x="84" y="150">Pays / Land:</text>
    <text class="val" x="270" y="138">Sweden</text>

    <text class="lbl" x="72" y="176">This public document</text>
    <text class="sm" x="84" y="188">Le présent acte public / Diese öffentliche Urkunde</text>

    <text class="lbl" x="72" y="212">2. has been signed by</text>
    <text class="sm" x="84" y="224">a été signé par</text>
    <text class="sm" x="84" y="235">ist unterschrieben von</text>
    <text class="val" x="270" y="212">Beatrice Gustafsson</text>

    <text class="lbl" x="72" y="260">3. acting in the capacity of</text>
    <text class="sm" x="84" y="272">agissant en qualité de</text>
    <text class="sm" x="84" y="283">in seiner/ihrer Eigenschaft als</text>
    <text class="val" x="270" y="260">Notary Public</text>

    <text class="lbl" x="72" y="308">4. bears the seal / stamp of</text>
    <text class="sm" x="84" y="320">est revêtu du sceau / timbre de</text>
    <text class="sm" x="84" y="331">sie ist versehen mit dem Siegel/Stempel des (der)</text>
    <text class="val" x="270" y="308">Notary Public office in Nacka</text>

    <text class="lbl" x="260" y="360" text-anchor="middle">Certified</text>
    <text class="sm" x="260" y="372" text-anchor="middle">Attesté / Bestätigt</text>

    <text class="lbl" x="72" y="396">5. at</text>
    <text class="sm" x="84" y="408">à / in</text>
    <text class="val b" x="160" y="396">Nacka</text>
    <text class="lbl" x="272" y="396">6. the</text>
    <text class="sm" x="284" y="408">le / am</text>

    <text class="lbl" x="72" y="446">7. by</text>
    <text class="sm" x="84" y="458">par / durch</text>
    <text class="val b" x="160" y="446">Notary Public Joakim Söderlindh</text>

    <text class="lbl" x="72" y="486">8. N°</text>
    <text class="sm" x="84" y="498">sous n°</text>
    <text class="sm" x="84" y="509">unter Nr.</text>

    <text class="lbl" x="72" y="538">9. Seal / stamp:</text>
    <text class="sm" x="84" y="550">Sceau / timbre :</text>
    <text class="sm" x="84" y="561">Siegel / Stempel:</text>

    <text class="lbl" x="272" y="538">10. Signature:</text>
    <text class="sm" x="284" y="550">Signature :</text>
    <text class="sm" x="284" y="561">Unterschrift:</text>

    <!-- underskrift -->
    <g class="signature">
      <path d="M292 612c8-34 18-52 28-46 8 6-8 34-16 46 14-34 30-58 42-50 10 8-6 30-2 34 6 4 20-22 30-16 6 4 0 16 8 14 10-4 18-16 26-8" />
      <path d="M382 606c10-34 22-50 32-42 8 8-10 38-18 46 12-30 30-54 40-44 8 8-4 26 2 28 8 2 18-16 26-10 6 6 2 14 12 12 8-2 14-12 18-6" />
    </g>

    <!-- blå stämpel -->
    <g class="stamp">
      <circle class="ring" cx="195" cy="590" r="40" />
      <circle class="ring thin" cx="195" cy="590" r="36" />
      <text class="stamp-text"><textPath href="#stamp-arc" startOffset="4%">NOTARY PUBLIC OF NACKA</textPath></text>
      <circle class="ring thin" cx="195" cy="590" r="15" />
      <path class="lattice" d="M185 584h20M185 590h20M185 596h20M189 580v20M195 580v20M201 580v20" />
      <text class="star" x="195" y="617" text-anchor="middle">✦</text>
    </g>

    <!-- förklaring under rutnätet -->
    <text class="fine" x="260" y="660" text-anchor="middle">This Apostille only certifies the authenticity of the signature and the capacity of the person who has signed</text>
    <text class="fine" x="260" y="671" text-anchor="middle">the public document, and, where appropriate, the identity of the seal or stamp which the public document bears.</text>
    <text class="fine" x="260" y="690" text-anchor="middle">This Apostille does not certify the content of the document for which it was issued.</text>

    <!-- guldsigill -->
    <g class="gold">
      <polygon points="410,696 415,702 422,698 425,705 433,703 434,711 442,711 440,719 448,721 444,728 451,732 445,738 450,744 443,748 446,755 438,757 439,765 431,764 430,772 422,769 419,776 412,772 407,778 402,772 395,776 392,769 384,772 383,764 375,765 376,757 368,755 371,748 364,744 369,738 363,732 370,728 366,721 374,719 372,711 380,711 381,703 389,705 392,698 399,702 404,696" />
      <circle class="gold-ring" cx="410" cy="742" r="31" />
      <text class="gold-text"><textPath href="#gold-arc" startOffset="12%">NOTARY PUBLIC</textPath></text>
      <circle class="gold-ring" cx="410" cy="742" r="12" />
      <path class="gold-lattice" d="M402 737h16M402 742h16M402 747h16M405 734v16M410 734v16M415 734v16" />
      <text class="gold-star" x="384" y="738">✦</text>
      <text class="gold-star" x="430" y="738">✦</text>
    </g>
  </svg>
</figure>

<style>
  .certificate { margin: 0; width: 100%; max-width: 560px; }
  svg { width: 100%; height: auto; overflow: visible; }
  .sheet-2 { fill: #ebe4d1; stroke: #dcd3bc; stroke-width: 1; }
  .sheet { fill: #f9f5ea; stroke: #e2dac6; stroke-width: 1; }
  .grid rect, .grid line { fill: none; stroke: #3b3f52; stroke-width: 0.8; }
  .h { font-family: var(--sans); font-weight: 700; font-size: 15px; letter-spacing: 0.02em; fill: #15182b; }
  .sub { font-family: var(--sans); font-size: 10px; fill: #2b2f44; }
  .lbl { font-family: var(--sans); font-weight: 700; font-size: 10.5px; fill: #15182b; }
  .sm { font-family: var(--sans); font-size: 7px; fill: #5a5e70; }
  .val { font-family: var(--sans); font-size: 10.5px; fill: #15182b; }
  .val.b { font-weight: 700; }
  .fine { font-family: var(--sans); font-size: 7.2px; fill: #2b2f44; }
  .signature path { fill: none; stroke: #1f3fb8; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .stamp { opacity: 0.85; }
  .stamp .ring { fill: none; stroke: #6a86d6; stroke-width: 1.6; }
  .stamp .ring.thin { stroke-width: 0.8; }
  .stamp-text { font-family: var(--sans); font-weight: 600; font-size: 7.4px; letter-spacing: 0.2em; fill: #6a86d6; }
  .lattice { fill: none; stroke: #6a86d6; stroke-width: 0.9; }
  .star { font-size: 7px; fill: #6a86d6; }
  .gold polygon { fill: url(#gold); stroke: #b8952f; stroke-width: 0.6; }
  .gold-ring { fill: none; stroke: #8f7020; stroke-width: 0.9; }
  .gold-text { font-family: var(--sans); font-weight: 700; font-size: 7.4px; letter-spacing: 0.22em; fill: #6e5412; }
  .gold-lattice { fill: none; stroke: #8f7020; stroke-width: 0.9; }
  .gold-star { font-size: 7px; fill: #8f7020; }
  .animate .signature path { stroke-dasharray: 360; stroke-dashoffset: 360; animation: draw 900ms ease-out forwards; }
  .animate .signature path:nth-child(1) { animation-delay: 400ms; }
  .animate .signature path:nth-child(2) { animation-delay: 1000ms; }
  .animate .stamp { transform-box: fill-box; transform-origin: center; opacity: 0; animation: stamp 480ms 1900ms cubic-bezier(0.2, 0.9, 0.3, 1) forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes stamp { from { opacity: 0; transform: scale(1.3) rotate(-8deg); } to { opacity: 0.85; transform: scale(1) rotate(0deg); } }
  @media (prefers-reduced-motion: reduce) {
    .animate .signature path { animation: none; stroke-dashoffset: 0; }
    .animate .stamp { animation: none; opacity: 0.85; }
  }
</style>
