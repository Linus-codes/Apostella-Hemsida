---
// Apostillecertifikatet enligt Haagkonventionens modell, ritat som linjegrafik. Bläckstämpel på papper.
// Underskriften ritas och sigillet landar en gång vid sidladdning. Ingen rörelse vid prefers-reduced-motion.
interface Props { alt: string; animate?: boolean }
const { alt, animate = false } = Astro.props;
---
<figure class:list={['certificate', { animate }]}>
  <svg viewBox="0 0 520 660" role="img" aria-labelledby="cert-title">
    <title id="cert-title">{alt}</title>
    <rect class="sheet-2" x="34" y="34" width="472" height="612" rx="3" />
    <rect class="sheet" x="14" y="14" width="472" height="612" rx="3" />
    <text class="title" x="250" y="74" text-anchor="middle">APOSTILLE</text>
    <text class="sub" x="250" y="96" text-anchor="middle">(Convention de La Haye du 5 octobre 1961)</text>
    <line class="rule" x1="44" y1="116" x2="456" y2="116" />
    <g class="fields">
      <text class="lbl" x="44" y="150">1. Country</text>
      <text class="val" x="190" y="150">SWEDEN</text>
      <line class="dots" x1="260" y1="154" x2="456" y2="154" />
      <text class="lbl" x="44" y="182">This public document</text>
      <text class="lbl" x="44" y="212">2. has been signed by</text>
      <text class="val" x="222" y="212">BEATRICE GUSTAFSSON</text>
      <text class="lbl" x="44" y="242">3. acting in the capacity of</text>
      <text class="val" x="262" y="242">NOTARIUS PUBLICUS</text>
      <text class="lbl" x="44" y="272">4. bears the seal/stamp of</text>
      <line class="dots" x1="250" y1="276" x2="456" y2="276" />
      <text class="lbl" x="44" y="308">Certified</text>
      <text class="lbl" x="44" y="338">5. at</text>
      <text class="val" x="92" y="338">STOCKHOLM</text>
      <text class="lbl" x="270" y="338">6. the</text>
      <line class="dots" x1="318" y1="342" x2="456" y2="342" />
      <text class="lbl" x="44" y="368">7. by</text>
      <text class="val" x="92" y="368">NOTARIUS PUBLICUS JOAKIM SÖDERLINDH</text>
      <text class="lbl" x="44" y="398">8. No</text>
      <line class="dots" x1="96" y1="402" x2="240" y2="402" />
      <text class="lbl" x="44" y="440">9. Seal/stamp:</text>
      <text class="lbl" x="270" y="440">10. Signature:</text>
    </g>
    <g class="signature">
      <path d="M284 528c8-30 22-52 30-38 6 12-6 40-14 44 12-24 34-58 52-44 10 8-2 28 6 30 12 2 26-26 42-20 8 4 6 16 16 10 10-6 18-14 26-12" />
    </g>
    <line class="rule" x1="270" y1="546" x2="456" y2="546" />
    <g class="seal">
      <circle class="ring" cx="130" cy="520" r="72" />
      <circle class="inner" cx="130" cy="520" r="56" />
      <path id="seal-arc" class="arc" d="M130 520 m-64 0 a64 64 0 1 1 128 0 a64 64 0 1 1 -128 0" />
      <text class="seal-text"><textPath href="#seal-arc" startOffset="2%">NOTARIUS PUBLICUS  ✦  SWEDEN  ✦  APOSTILLE  ✦</textPath></text>
      <image href="/apostella-marke.png" x="105" y="495" width="50" height="50" />
    </g>
  </svg>
</figure>

<style>
  .certificate { margin: 0; width: 100%; max-width: 520px; }
  svg { width: 100%; height: auto; overflow: visible; }
  .sheet-2 { fill: #ebe4d1; stroke: #dcd3bc; stroke-width: 1; }
  .sheet { fill: #f9f5ea; stroke: #e2dac6; stroke-width: 1; }
  .title { font-family: var(--sans); font-weight: 700; font-size: 22px; letter-spacing: 0.16em; fill: var(--ink); }
  .sub { font-family: var(--sans); font-size: 10.5px; fill: var(--text-2); }
  .rule { stroke: #d9d1bc; stroke-width: 1; }
  .dots { stroke: #cfc6ae; stroke-width: 1; stroke-dasharray: 1 3; }
  .lbl { font-family: var(--sans); font-size: 11.5px; fill: var(--text-2); }
  .val { font-family: var(--mono); font-size: 12px; letter-spacing: 0.04em; fill: var(--ink); font-weight: 500; }
  .signature path { fill: none; stroke: var(--blue); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .seal .ring { fill: none; stroke: var(--blue); stroke-width: 2; }
  .seal .inner { fill: none; stroke: var(--blue); stroke-width: 1; stroke-dasharray: 2 3; }
  .seal .arc { fill: none; stroke: none; }
  .seal-text { font-family: var(--sans); font-weight: 600; font-size: 9.5px; letter-spacing: 0.22em; fill: var(--blue); }
  .seal { opacity: 0.94; mix-blend-mode: multiply; }
  .animate .signature path { stroke-dasharray: 420; stroke-dashoffset: 420; animation: draw 1100ms 400ms ease-out forwards; }
  .animate .seal { transform-box: fill-box; transform-origin: center; opacity: 0; animation: stamp 520ms 1500ms cubic-bezier(0.2, 0.9, 0.3, 1) forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes stamp { from { opacity: 0; transform: scale(1.3) rotate(-7deg); } to { opacity: 0.94; transform: scale(1) rotate(0deg); } }
  @media (prefers-reduced-motion: reduce) {
    .animate .signature path { animation: none; stroke-dashoffset: 0; }
    .animate .seal { animation: none; opacity: 0.94; }
  }
</style>
